{
  "name": "llama2_rag_sage",
  "description": "Run Llama-2-7B with RAG and SAGE on the HealthcareMagic dataset",
  "verbose": true,
  "random_seed": 42,
  "output_dir": "D:/Projects/privacy-preserving-biomedical-qa/outputs/llama2_rag_sage_healthcaremagic",
  "data_dir": "D:/Projects/privacy-preserving-biomedical-qa/data/healthcaremagic",
  "synthetic_data_dir": "D:/Projects/privacy-preserving-biomedical-qa/data/synthetic/healthcaremagic",
  "llm": {
    "model_name": "meta-llama/Llama-2-7b-chat-hf",
    "max_new_tokens": 512,
    "temperature": 0.1,
    "use_gpu": true,
    "use_8bit": true,
    "use_4bit": false,
    "cache_dir": "D:/Projects/privacy-preserving-biomedical-qa/models",
    "use_flash_attention": false
  },
  "rag": {
    "enabled": true,
    "top_k": 5,
    "chunk_size": 256,
    "chunk_overlap": 50,
    "encoder_model": "sentence-transformers/all-MiniLM-L6-v2",
    "vector_store_dir": "D:/Projects/privacy-preserving-biomedical-qa/vector_stores/healthcaremagic"
  },
  "sage": {
    "enabled": true,
    "generator_model": "meta-llama/Llama-2-7b-chat-hf",
    "num_records": 100,
    "batch_size": 10,
    "synthetic_data_dir": "D:/Projects/privacy-preserving-biomedical-qa/data/synthetic/healthcaremagic",
    "attributes_to_anonymize": ["patient_name", "doctor_name", "hospital_name", "address"],
    "max_workers": 1
  },
  "evaluation": {
    "benchmark_file": "D:/Projects/privacy-preserving-biomedical-qa/benchmarks/biomedical_qa_benchmark.json",
    "dataset_name": "healthcaremagic",
    "evaluate_accuracy": true,
    "evaluate_privacy": true,
    "num_queries": 50,
    "output_file": "D:/Projects/privacy-preserving-biomedical-qa/outputs/llama2_rag_sage_healthcaremagic/results.json"
  }
} 